{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lager-iphone",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lager-iphone"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "secrets": {
    "required": [
      "TRADERA_APP_ID",
      "TRADERA_APP_KEY"
    ]
  }
}
